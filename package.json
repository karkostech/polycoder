{
  "name": "chalkcode",
  "version": "0.1.0",
  "description": "Multi-model AI coding orchestrator: parallel CLI agents on git worktrees with a shared markdown blackboard, an integrator pass and a final build report.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "chalkcode": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "test": "npm run build && node scripts/run-tests.mjs",
    "cli": "node dist/src/cli.js"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestrator",
    "cli",
    "multi-model",
    "git-worktree",
    "coding-assistant"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
